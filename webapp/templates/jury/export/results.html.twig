{% extends 'jury/export/layout.html.twig' %}

{% block body %}
    <h2>수상 팀</h2>
    <table class="table">
        <thead>
        <tr>
            <th scope="col">순위</th>
            <th scope="col">팀</th>
            <th scope="col">상(Award)</th>
            <th scope="col">해결한 문제 수</th>
            <th scope="col">총 페널티 시간</th>
            <th scope="col">마지막 정답 제출 시간</th>
        </tr>
        </thead>
        <tbody>
        {% for row in awarded %}
            <tr>
                <th scope="row">{{ row.rank }}</th>
                <th scope="row">{{ row.team }}</th>
                <td>{{ row.award }}</td>
                <td>{{ row.solved }}</td>
                <td>{{ row.total_time }}</td>
                <td>{{ row.max_time }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2>기타 순위 팀</h2>
    <table class="table">
        <thead>
        <tr>
            <th scope="col">순위</th>
            <th scope="col">팀</th>
            <th scope="col">해결한 문제 수</th>
        </tr>
        </thead>
        <tbody>
        {% for row in ranked %}
            <tr>
                <th scope="row">{{ row.rank }}</th>
                <th scope="row">{{ row.team }}</th>
                <td>{{ row.solved }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2>가작/장려상 (Honorable mentions)</h2>
    <table class="table">
        <tbody>
        {% for row in honorable|batch(2) %}
            <tr>
                {% for team in row %}
                    <td>{{ team }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2>지역 우승팀</h2>
    <table class="table">
        <thead>
        <tr>
            <th scope="col">지역</th>
            <th scope="col">팀</th>
            <th scope="col">순위</th>
        </tr>
        </thead>
        <tbody>
        {% for row in regionWinners %}
            <tr>
                <th scope="row">{{ row.group }}</th>
                <td>{{ row.team }}</td>
                <td>{{ row.rank }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h2>최초 해결 (First to solve)</h2>
    <table class="table">
        <thead>
        <tr>
            <th scope="col">문제</th>
            <th scope="col">팀</th>
            <th scope="col">순위</th>
            <th scope="col">시간</th>
        </tr>
        </thead>
        <tbody>
        {% for row in firstToSolve %}
            <tr>
                <th scope="row">{{ row.problem }}: {{ row.problem_name }}</th>
                <td>
                    {% if row.team is not null %}
                        {{ row.team }}
                    {% else %}
                        <i>미해결</i>
                    {% endif %}
                </td>
                <td>
                    {% if row.rank is not null %}
                        {{ row.rank }}
                    {% else %}
                        <i>-</i>
                    {% endif %}
                </td>
                <td>
                    {% if row.time is not null %}
                        {{ row.time }}
                    {% else %}
                        <i>-</i>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
