{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}사용자 {{ user.userid }} - {{ parent() }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.table_extrahead() }}
{% endblock %}

{% block content %}

    <h1>사용자 {{ user.name }}</h1>

    <div class="row">
        <div class="col-lg-4">
            <table class="table table-sm table-striped">
                <tr>
                    <th>ID</th>
                    <td>{{ user.userid }}</td>
                </tr>
                {% if showExternalId(user) %}
                    <tr>
                        <th>외부 ID</th>
                        <td>{{ user.externalid }}</td>
                    </tr>
                {% endif %}
                <tr>
                    <th>로그인 이름</th>
                    <td class="teamid">{{ user.username }}</td>
                </tr>
                <tr>
                    <th>이메일</th>
                    <td>
                        {% if user.email %}
                            <a href="mailto:{{ user.email }}">{{ user.email }}</a>
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>비밀번호</th>
                    <td>
                        {% if user.password %}
                            설정됨
                        {% else %}
                            설정되지 않음
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>IP 주소</th>
                    <td>
                        {% if user.ipAddress %}
                            {{ user.ipAddress }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>활성화됨</th>
                    <td>
                        {{ user.enabled | printYesNo }}
                    </td>
                </tr>
                <tr>
                    <th>역할</th>
                    <td>
                        {% for role in user.userRoles %}
                            {{ role.description }}<br>
                        {% else %}
                            할당된 역할 없음
                        {% endfor %}
                    </td>
                </tr>
                <tr>
                    <th>팀</th>
                    {% if user.team %}
                        <td class="teamid">
                            <a href="{{ path('jury_team', {'teamId': user.team.teamid}) }}">
                                {{ user.team.effectiveName }} {{ user.team | entityIdBadge('t') }}
                            </a>
                        </td>
                    {% else %}
                        <td>-</td>
                    {% endif %}
                </tr>
            </table>
        </div>

        <div class="col-lg-4">
            <table class="table table-sm table-striped">
                <tr>
                    <th>첫 로그인</th>
                    <td>
                        {% if user.firstLogin %}
                            {{ user.firstLogin | printtime('D d M Y H:i:s T') }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>마지막 로그인</th>
                    <td>
                        {% if user.lastLogin %}
                            {{ user.lastLogin | printtime('D d M Y H:i:s T') }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>마지막 API 로그인</th>
                    <td>
                        {% if user.lastApiLogin %}
                            {{ user.lastApiLogin | printtime('D d M Y H:i:s T') }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>마지막 IP</th>
                    <td>
                        {% if user.lastIpAddress %}
                            {{ user.lastIpAddress | printHost(true) }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div class="button-row">
        {%- if is_granted('ROLE_ADMIN') -%}
            {{ button(path('jury_user_edit', {'userId': user.userid}), '수정', 'primary', 'edit') }}
            {{ button(path('jury_user_delete', {'userId': user.userid}), '삭제', 'danger', 'trash-alt', true) }}
        {% endif %}
        {% include 'jury/partials/rejudge_form.html.twig' with {table: 'user', id: user.userid, buttonClass: 'btn-secondary'} %}
    </div>

    <h2>{{ user.name }}의 제출물</h2>

    <div data-ajax-refresh-target>
        {%- include 'jury/partials/submission_list.html.twig' with {showTestcases: false} %}
    </div>

{% endblock %}
