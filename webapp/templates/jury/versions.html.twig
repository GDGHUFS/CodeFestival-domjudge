{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}컴파일러 및 실행기 버전 개요{% endblock %}

{% block extrahead %}
    {{ parent() }}
    <script src="{{ asset('js/ace/ace.js') }}"></script>
    <script src="{{ asset('js/ace/ext-modelist.js') }}"></script>
    {{ macros.table_extrahead() }}
{% endblock %}

{% block content %}
    <h1>컴파일러 및 실행기 버전 개요</h1>

    {% for lang in data %}
        <div class="card mb-3">
            <div class="card-header">
                언어 <code>{{ lang.language.langid }}</code>
                {% if is_granted('ROLE_ADMIN') %}
                <span style="float: right">
                    {{ button(path('jury_language_edit', {'langId': lang.language.langid}), '버전 명령어(들) 수정', 'primary btn-sm', 'edit') }}
                </span>
                {% endif %}
            </div>
            <div class="card-body">
                <div class="card-title">
                    <div class="row">
                        <div class="col-sm">
                            <h6>컴파일러 버전(들)</h6>
                            {% if lang.compiler_outputs | length > 1 %}
                                <div class="alert alert-danger" role="alert">버전이 일치하지 않습니다.</div>
                            {% endif %}
                            {% for key, output in lang.compiler_outputs %}
                                <div class="card">
                                    <div class="card-header">
                                        {% if key == lang.canonical_compiler_key %}
                                            <span class="badge text-bg-success">표준 버전</span>
                                        {% else %}
                                            <span class="badge text-bg-danger">비표준</span>
                                            {{ button(path('jury_compiler_promote', {'versionId': output.versionid}), '표준으로 지정', 'primary btn-sm', 'bookmark') }}
                                        {% endif %}
                                    </div>
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item">
                                            <pre class="output_text" style="background-color: rgba(0,121,54,.1);">$ {{ output.command }}</pre>
                                            <pre class="output_text">{{ output.version }}</pre>
                                        </li>
                                        <li class="list-group-item">
                                            처음 보고한 호스트:
                                            <ul>
                                                {% for host in output.hostdata %}
                                                    <li>
                                                        {{ host.hostname | printHost }}: {{ host.last_changed | printHumanTimeDiff }}
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            {% endfor %}
                            {% if lang.runner_outputs | length > 0 %}
                                <br/>
                                <h6>실행기 버전(들)</h6>
                                {% if lang.runner_outputs | length > 1 %}
                                    <div class="alert alert-danger" role="alert">버전이 일치하지 않습니다.</div>
                                {% endif %}
                                {% for key, output in lang.runner_outputs %}
                                    <div class="card">
                                        <div class="card-header">
                                            {% if key == lang.canonical_runner_key %}
                                                <span class="badge text-bg-success">표준 버전</span>
                                            {% else %}
                                                <span class="badge text-bg-danger">비표준</span>
                                                {{ button(path('jury_runner_promote', {'versionId': output.versionid}), '표준으로 지정', 'primary btn-sm', 'bookmark') }}
                                            {% endif %}
                                        </div>
                                        <ul class="list-group list-group-flush">
                                            <li class="list-group-item">
                                                <pre class="output_text" style="background-color: rgba(0,121,54,.1);">$ {{ output.command }}</pre>
                                                <pre class="output_text">{{ output.version }}</pre>
                                            </li>
                                            <li class="list-group-item">
                                                처음 보고한 호스트:
                                                <ul>
                                                    {% for host in output.hostdata %}
                                                        <li>
                                                            {{ host.hostname | printHost }}: {{ host.last_changed | printHumanTimeDiff }}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            </li>
                                        </ul>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
{% endblock %}
