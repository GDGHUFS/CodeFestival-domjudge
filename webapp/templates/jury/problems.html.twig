{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}문제 - {{ parent() }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.table_extrahead() }}
{% endblock %}

{% block content %}

    <h1>문제</h1>

    {{ macros.table(problems, table_fields) }}

    {% if is_granted('ROLE_ADMIN') %}
        <p>
            {{ button(path('jury_problem_add'), '새 문제 추가', 'primary', 'plus') }}
            {{ button(path('jury_import_export', {'_fragment':'problemarchive'}), '문제 가져오기', 'primary', 'upload') }}
        </p>
    {% endif %}
{% endblock %}
