{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}문제 {{ problem.probid }} 편집 - {{ parent() }}{% endblock %}

{% block content %}

    <h1>문제 {{ problem.probid }} 편집</h1>

    <div class="row">
        <div class="col-lg-4">
            <table class="table table-sm table-striped">
                <tr>
                    <th>문제 ID</th>
                    <td>{{ problem.probid }}</td>
                </tr>
                <tr>
                    <th>테스트케이스</th>
                    <td>
                        {% if problem.testcases is empty %}
                            <em>테스트케이스 없음</em>
                        {% else %}
                            <a href="{{ path('jury_problem_testcases', {'probId': problem.probid}) }}">세부 정보 / 편집</a>
                        {% endif %}
                    </td>
                </tr>
            </table>
        </div>
    </div>

    {% include 'jury/partials/problem_form.html.twig' %}

    {% if is_granted('ROLE_ADMIN') %}
        <hr>
        <i>또는</i>

        <div class="row">
            <div class="col-lg-4">
                {{ form(uploadForm) }}
            </div>
        </div>
    {% endif %}

{% endblock %}
