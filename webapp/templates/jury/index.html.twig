{% extends "jury/base.html.twig" %}

{% block title %}{{ parent() }} - Jury 인터페이스{% endblock %}

{% block extrahead %}
{{ parent() }}
{% endblock %}

{% block content %}
<h1>DOMjudge Jury 인터페이스</h1>

<a href="https://www.domjudge.org/">
  <img src="{{ asset('images/DOMjudgelogo.svg') }}" id="djlogo" alt="DOMjudge 로고" class="float-end d-none d-md-block" title="The DOMjudge logo: free as in beer!">
</a>

<div class="row equal mt-3">
    <div class="col-lg-4 col-md-5 col-sm-6 mt-3">
        {% if is_granted('ROLE_JURY') %}
        <div class="card mb-3">
            <div class="card-header">
                대회 전:
            </div>
            <div class="card-body">
                <ul>
                    <li><a href="{{ path('jury_contests') }}">대회</a></li>
                    <li><a href="{{ path('jury_executables') }}">실행 파일</a></li>
                    <li><a href="{{ path('jury_judgehosts') }}">Judgehost</a></li>
                    <li><a href="{{ path('jury_languages') }}">언어</a></li>
                    <li><a href="{{ path('jury_problems') }}">문제</a></li>
                    <li><a href="{{ path('jury_problemset') }}">팀 문제 세트 페이지 미리보기</a></li>
                    <li><a href="{{ path('jury_users') }}">사용자</a></li>
                    <li><a href="{{ path('jury_teams') }}">팀</a></li>
                    <li><a href="{{ path('jury_team_categories') }}">팀 카테고리</a></li>
                    <li><a href="{{ path('jury_team_affiliations') }}">팀 소속</a></li>
                    <li><a href="{{ path('jury_judging_verifier') }}">채점 검증기</a></li>
                    <li><a href="{{ path('jury_versions') }}">컴파일러 및 실행기 버전</a></li>
                </ul>
            </div>
        </div>
        {% endif %}

        <div class="card mb-3">
            <div class="card-header">
                대회 중:
            </div>
            <div class="card-body">
                <ul>
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_BALLOON') %}
                        <li><a href="{{ path('jury_balloons') }}">풍선 상태</a></li>
                    {% endif %}
                    {% if is_granted('ROLE_CLARIFICATION_RW') %}
                        <li><a href="{{ path('jury_clarifications') }}">질의 응답</a></li>
                    {% endif %}
                    {% if is_granted('ROLE_JURY') %}
                        <li><a href="{{ path('jury_internal_errors') }}">내부 오류</a></li>
                    {% endif %}
                    {% if have_printing %}
                        <li><a href="{{ path('jury_print') }}">인쇄</a></li>
                    {% endif %}
                    {% if is_granted('ROLE_JURY') %}
                        <li><a href="{{ path('jury_rejudgings') }}">재채점</a></li>
                        <li><a href="{{ path('jury_scoreboard') }}">스코어보드</a></li>
                        <li><a href="{{ path('analysis_index') }}">통계/분석</a></li>
                        <li><a href="{{ path('jury_submissions') }}">제출물</a></li>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li><a href="{{ path('jury_queue_tasks') }}">큐 작업</a></li>
                        {% endif %}
                        {% if show_shadow_differences %}
                            <li><a href="{{ path('jury_shadow_differences') }}">그림자 차이</a></li>
                            <li><a href="{{ path('jury_external_contest') }}">외부 대회</a></li>
                        {% endif %}
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>

  <div class="col-lg-4 col-md-5 col-sm-6 mt-3">
    {% if is_granted('ROLE_ADMIN') %}
    <div class="card mb-3">
      <div class="card-header">
        관리자:
      </div>
      <div class="card-body">
        <ul>
          <li><a href="{{ path('jury_config') }}">설정 구성</a></li>
          <li><a href="{{ path('jury_config_check') }}">구성 검사기</a></li>
          <li><a href="{{ path('jury_import_export') }}">가져오기 / 내보내기</a></li>
          <li><a href="{{ path('jury_generate_passwords') }}">팀 비밀번호 관리</a></li>
          <li><a href="{{ path('jury_refresh_cache') }}">스코어보드 캐시 새로 고침</a></li>
          <li><a href="{{ path('jury_auditlog') }}">감사 로그</a></li>
          {% if adminer_enabled %}
            <li><a href="{{ path('jury_adminer', {username: '', db: 'domjudge'}) }}">Adminer 데이터베이스 편집기</a></li>
          {% endif %}
        </ul>
      </div>
    </div>
    {% endif %}

    <div class="card mb-3">
      <div class="card-header">
        문서:
      </div>
      <div class="card-body">
        <ul>
        <li><a href="{{ asset('doc/manual/html/index.html') }}">DOMjudge 매뉴얼</a></li>
        <li><a href="{{ asset('doc/manual/domjudge-team-manual.pdf') }}">팀 매뉴얼 <i class="fas fa-file-pdf"></i></a></li>
        <li><a href="{{ path('app.swagger_ui') }}">API 문서</a><br />
            <a href="{{ CCS_SPEC_API_URL }}">ICPC Contest API</a>도 참조하십시오.</li>
        </ul>
      </div>
    </div>
  </div>
</div>
{% endblock %}
