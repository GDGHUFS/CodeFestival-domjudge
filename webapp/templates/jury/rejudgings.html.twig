{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}재심사 - {{ parent() }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.table_extrahead() }}
{% endblock %}

{% block content %}

    <h1>재심사</h1>

    {% if rejudgings is empty %}
        <div class="alert alert-warning">정의된 재심사가 없습니다.</div>
    {% else %}
        {{ macros.table(rejudgings, table_fields, 0) }}
    {% endif %}

    <p>
        {{ button(path('jury_rejudging_add'), '새 재심사 추가', 'primary', 'plus') }}
    </p>

{% endblock %}
