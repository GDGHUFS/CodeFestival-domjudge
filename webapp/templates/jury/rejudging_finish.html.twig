{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}{{ action | capitalize }} 재심사 r{{ rejudging.rejudgingid }} - {{ parent() }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.table_extrahead() }}
    {{ macros.select2_extrahead() }}
{% endblock %}

{% block content %}

    <h1>{{ action | capitalize }} 재심사
        <a href="{{ path('jury_rejudging', {'rejudgingId': rejudging.rejudgingid}) }}">r{{ rejudging.rejudgingid }}</a>
    </h1>

    {% if action == 'apply' %}
        {% set progressBarMessage = '재심사를 적용하는 데 시간이 걸릴 수 있습니다. 잠시 기다려 주십시오.' %}
    {% else %}
        {% set progressBarMessage = '' %}
    {% endif %}
    {{ macros.progress_bar(progressBarMessage) }}
{% endblock %}

{% block extrafooter %}
    {{ macros.progress_loader(path('jury_rejudging_finish', {rejudgingId: rejudging.rejudgingid, action: action})) }}
{% endblock %}
