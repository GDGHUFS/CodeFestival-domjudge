{% extends "jury/base.html.twig" %}

{% block title %}가져오기 및 내보내기 - {{ parent() }}{% endblock %}

{% block content %}

    <h1>가져오기 및 내보내기</h1>

    <div class="importexport">
    <h2 id="problemarchive">문제</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="tile">
                <h3>아카이브 가져오기</h3>
                {{ form(problem_form) }}
            </div>
        </div>
    </div>

    <h2 id="contests">대회</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="tile">
                <h3>JSON / YAML 가져오기</h3>
                {{ form(contest_import_form) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="tile">
                <h3>YAML 내보내기</h3>
                {{ form(contest_export_form) }}
            </div>
        </div>
    </div>

    <h2 id="problems">문제 정의</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="tile">
                <h3>JSON / YAML 가져오기</h3>
                {{ form(problems_import_form) }}
            </div>
        </div>
    </div>


    <h2 id="teams">팀 및 그룹</h2>
    <div class="row">
        <div class="col-md-6">
            <div class="tile">
            <h3>탭으로 구분된(TSV) 파일 가져오기</h3>
                {{ form(tsv_form) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="tile">
                <h3>탭으로 구분된(TSV) 파일 내보내기</h3>
                <ul>
                {% for type in ['groups', 'teams'] %}
                    <li>
                        <a href="{{ path('jury_tsv_export', {'type': type}) }}"><code>{{ type }}.tsv</code></a>
                    </li>
                {% endfor %}
                </ul>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="tile">
            <h3>JSON / YAML 가져오기</h3>
                {{ form(json_form) }}
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="tile">
            <h3>ICPC CMS에서 팀 가져오기</h3>
                {{ form_start(icpccms_form) }}
                {{ form_row(icpccms_form.contest_id) }}
                {{ form_row(icpccms_form.access_token) }}
                {{ form_widget(icpccms_form.fetch_teams) }}
                {{ form_end(icpccms_form) }}
            </div>
        </div>
    </div>

    <h2 id="results">결과</h2>
    <div class="row">
        <div class="col-md-6">
        </div>
        <div class="col-md-6">
            <div class="tile">
                <h3>&lt;html&gt; 내보내기</h3>
                    <ul>
                        <li>
                            <code>wf_results.html</code>:
                            <ul>
                                {% for sort_order, names in sort_orders %}
                                    <li>
                                        <a href="{{ path('jury_html_export', {'type': 'wf_results', 'sort_order': sort_order}) }}">정렬 순서 {{ sort_order }}용</a>
                                        ({{ names | join(', ') }})
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                        <li>
                            <code>full_results.html</code>:
                            <ul>
                                {% for sort_order, names in sort_orders %}
                                    <li>
                                        <a href="{{ path('jury_html_export', {'type': 'full_results', 'sort_order': sort_order}) }}">정렬 순서 {{ sort_order }}용</a>
                                        ({{ names | join(', ') }})
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                        <li>
                            <a href="{{ path('jury_html_export', {'type': 'clarifications'}) }}" target="_blank"><code>clarifications.html</code></a>
                        </li>
                    </ul>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
        </div>
        <div class="col-md-6">
            <div class="tile">
                <h3>탭으로 구분된(TSV) 파일 내보내기</h3>
                    <ul>
                        <li>
                            <code>wf_results.tsv</code>:
                            <ul>
                            {% for sort_order, names in sort_orders %}
                                <li>
                                    <a href="{{ path('jury_tsv_export', {'type': 'wf_results', 'sort_order': sort_order}) }}">정렬 순서 {{ sort_order }}용</a>
                                    ({{ names | join(', ') }})
                                 </li>
                            {% endfor %}
                            </ul>
                        </li>
                        <li>
                            <code>full_results.tsv</code>:
                            <ul>
                                {% for sort_order, names in sort_orders %}
                                    <li>
                                        <a href="{{ path('jury_tsv_export', {'type': 'full_results', 'sort_order': sort_order}) }}">정렬 순서 {{ sort_order }}용</a>
                                        ({{ names | join(', ') }})
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                    </ul>
             </div>
        </div>
    </div>
    </div>

{% endblock %}
