{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.select2_extrahead() }}
{% endblock %}

{% block title %}내부 오류 해결 - {{ parent() }}{% endblock %}

{% block content %}

    <h1>내부 오류를 해결하는 중...</h1>

    <div class="row">
        <div class="col-lg-12">
            {{ macros.progress_bar('내부 오류를 해결하는 중입니다. 시간이 걸릴 수 있습니다...') }}
        </div>
    </div>

{% endblock %}

{% block extrafooter %}
    {{ macros.progress_loader(url) }}
{% endblock %}
