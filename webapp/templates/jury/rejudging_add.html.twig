{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.select2_extrahead() }}
{% endblock %}

{% block title %}재심사 생성 중 - {{ parent() }}{% endblock %}

{% block content %}

    <h1>재심사 생성 중...</h1>

    <div class="row">
        <div class="col-lg-12">
            {{ macros.progress_bar('재심사 생성 중. 시간이 다소 걸릴 수 있습니다...') }}
        </div>
    </div>

{% endblock %}

{% block extrafooter %}
    {{ macros.progress_loader(url, data) }}
{% endblock %}
