{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}설정 확인 - {{ parent() }}{% endblock %}

{% block content %}
<div class="card w-40 float-end m-5">
  <div class="card-body">
  <h5 class="card-title">시스템 정보</h5>
  <table class="w-100">
  <tr><td>DOMjudge:</td><td id="dj_version">{{ DOMJUDGE_VERSION }}</td></tr>
  <tr><td>환경:</td><td>{{ app.environment }}</td></tr>
  <tr><td>디버그:</td><td>{{ app.debug|printYesNo }}</td></tr>
  <tr><td colspan="2">&nbsp;</td></tr>
  <tr><td>PHP:</td><td>{{ constant('PHP_VERSION') }}</td></tr>
  <tr><td>Symfony:</td><td>{{ constant('\\Symfony\\Component\\HttpKernel\\Kernel::VERSION') }}</td></tr>
  <tr><td>Twig:</td><td>{{ constant('\\Twig\\Environment::VERSION') }}</td></tr>
  </table>
  </div>
</div>

<h1>설정 확인</h1>

<div class="card m-3 bg-light">
  <div class="card-body">
  <h5 class="card-title">설치 위치</h5>
  <table class="w-100">
  <tr><td>기본 URL (제출 클라이언트에서 사용):</td><td><kbd>{{ url('root') }}</kbd></td></tr>
  <tr><td>API URL (<kbd>restapi.secret</kbd>에서 사용):</td><td><kbd>{{ url('current_api_root') | trim('/', 'right') }}</kbd></td></tr>
  <tr><td colspan="2">&nbsp;</td></tr>
  <tr><td>DOMserver 설치 경로:</td><td><kbd>{{ dir.project }}</kbd></td></tr>
  <tr><td>로고/이미지 경로:</td><td><kbd>{{ dir.project }}/webapp/public/images/</kbd></td></tr>
  <tr><td>사용자 정의 CSS 경로:</td><td><kbd>{{ dir.project }}/webapp/public/css/custom/</kbd></td></tr>
  <tr><td>사용자 정의 JavaScript 경로:</td><td><kbd>{{ dir.project }}/webapp/public/js/custom/</kbd></td></tr>
  <tr><td>문서 파일 경로:</td><td><kbd>{{ dir.project }}/webapp/public/docs/</kbd></td></tr>
  <tr><td>DOMjudge 콘솔 바이너리:</td><td><kbd>{{ dir.project }}/webapp/bin/console</kbd></td></tr>
  <tr><td>로그 디렉터리:</td><td><kbd>{{ dir.log }}</kbd></td></tr>
  </table>

      {% if logFilesWithSize is not empty %}
          <h5 class="card-title mt-3">로그 파일</h5>
          <table class="w-100">
              <thead>
              <tr>
                  <th>파일</th>
                  <th>크기</th>
                  <th>액션</th>
              </tr>
              </thead>
              <tbody>
              {% for logFile, size in logFilesWithSize %}
                  <tr>
                      <td><kbd>{{ logFile }}</kbd></td>
                      <td>{{ size }}</td>
                      <td>
                          <a href="{{ path('jury_tail_log', {'logFile': logFile}) }}" class="btn btn-outline-secondary btn-sm">
                              <i class="fas fa-terminal"></i>
                              마지막 200줄 가져오기
                          </a>
                          <a href="{{ path('jury_download_log', {'logFile': logFile}) }}" class="btn btn-outline-secondary btn-sm">
                              <i class="fas fa-download"></i>
                              다운로드
                          </a>
                      </td>
                  </tr>
              {% endfor %}
              </tbody>
          </table>
      {% endif %}
  </div>
</div>

<h2>확인 목록</h2>

{% for resultgroup,groupresults in results %}
<h3 class="mt-3 ms-3">{{ resultgroup }}</h3>

<div class="accordion w-50 ms-5" id="{{ resultgroup|replace({' ':''}) }}" role="tablist" aria-multiselectable="true">

{% for test,testresult in groupresults %}
  <div class="card">
    <h6 class="card-header result {{ testresult.result }}" role="tab" id="heading{{ test }}">
      <a class="collapsed d-block text-dark pt-0 pb-0" data-bs-toggle="collapse" href="#collapse{{ test }}" aria-expanded="true" aria-controls="collapse{{ test }}" data-parent="#{{ resultgroup|replace({' ':''}) }}">
        {% if testresult.result == 'O' %}
        <i class="fas fa-check text-success"></i>
        {% elseif testresult.result == 'W' %}
        <i class="fas fa-exclamation-triangle text-warning"></i>
        {% elseif testresult.result == 'E' %}
        <i class="fas fa-skull-crossbones text-danger"></i>
        {% endif %}
        <i class="fa fa-chevron-down float-end"></i>
        {{ testresult.caption }}
      </a>
    </h6>

    <div id="collapse{{ test }}" class="collapse collapsed" role="tabpanel" aria-labelledby="heading{{ test }}">
      <div class="card-body">
        {% set description = testresult.desc %}
        {% if testresult.escape is not defined or testresult.escape %}
          {% set description = description | escape %}
        {% endif %}
        {{ description | replace({"\n":"<br />\n"}) | raw }}
      </div>
    </div>
  </div>

{% endfor %}
</div>

{% endfor %}

<div class="mt-5 mb-5">
모든 확인 완료. <i class="fas fa-clipboard-check"></i>
</div>

<details>
<summary class="text-muted">시간 측정 정보</summary>
<ul>
{% for section in stopwatch.sections %}
  {% if section.id %}
  <li><strong>{{ section.id }}</strong>
    <ul>
    {% for event in section.events %}
      {% if event.name != '__section__' %}
      <li>{{ event }}</li>
      {% endif %}
    {% endfor %}
    </ul>
  </li>
  {% endif %}
{% endfor %}
</ul>
</details>

{% endblock %}
