{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}팀 - {{ parent() }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.table_extrahead() }}
{% endblock %}

{% block content %}

    <h1>팀</h1>

    {{ macros.table(teams, table_fields) }}

    {%- if is_granted('ROLE_ADMIN') %}

        <p>
            {{ button(path('jury_team_add'), '새 팀 추가', 'primary', 'plus') }}
            {{ button(path('jury_import_export', {'_fragment':'teams'}), '팀 가져오기', 'primary', 'upload') }}
        </p>
    {%- endif %}
{% endblock %}
