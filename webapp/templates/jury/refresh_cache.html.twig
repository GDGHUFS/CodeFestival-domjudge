{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}캐시 새로고침 - {{ parent() }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.table_extrahead() }}
{% endblock %}

{% block content %}

    <h1>캐시 새로고침</h1>

    {% if doRefresh %}
        {{ macros.progress_bar() }}
    {% else %}
        <div class="alert alert-warning">
            <h5 class="alert-heading">상당한 데이터베이스 영향</h5>
            <hr>
            <p>
                스코어보드 캐시를 새로고침하는 것은 데이터베이스 부하에 상당한 영향을 미칠 수 있으며,
                정상적인 운영 환경에서는 필요하지 않습니다.
                <br/><br/>
                다음 스코어보드 캐시를 지금 새로고침하시겠습니까? 
                {% if current_contest is not empty %}
                    {{ current_contest.name }}
                {% else %}
                    모든 활성 대회
                {% endif %}
                
            </p>
            <form action="{{ path('jury_refresh_cache') }}" method="post">
                {% if current_contest is not empty %}
                    <input type="hidden" name="cid" value="{{ current_contest.cid }}"/>
                {% endif %}
                <button type="submit" class="btn btn-danger" name="refresh">
                    <i class="fas fa-sync-alt"></i> 지금 새로고침!
                </button>
            </form>
        </div>
    {% endif %}
{% endblock %}

{% block extrafooter %}
    {% if doRefresh %}
        {% set progressUrl = path('jury_refresh_cache') %}
        {% if current_contest is not empty %}
            {% set progressUrl = progressUrl ~ '?cid=' ~ current_contest.cid %}
        {% endif %}
        {{ macros.progress_loader(progressUrl) }}
    {% endif %}
{% endblock %}
