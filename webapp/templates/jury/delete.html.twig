{% extends "jury/base.html.twig" %}

{% block title %}삭제: {{ type }} {{ primaryKey }} - "{{ description }}" - {{ parent() }}{% endblock %}


{% block content %}

    <h1>삭제: {{ type }} {{ primaryKey }} - "{{ description }}"</h1>

    {% if isError %}
        <div class="alert alert-danger">
            <strong>오류: {{ messages.0 }}</strong>
        </div>
    {% else %}
        <div class="alert alert-warning">
            <form method="post">
                <p>현재 {{ type }} {{ primaryKey }} "{{ description }}"을(를) 삭제하려고 합니다.</p>

                {% if messages is not empty %}
                    <p>
                        <strong>경고, 이 작업은 다음을 수행합니다:</strong>
                    </p>
                    <ul>
                        {% for message in messages %}
                            <li>{{ message }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}

                <p>정말로 삭제하시겠습니까?</p>
                <hr>
                <a href="{{ redirectUrl }}" class="btn btn-secondary">취소</a>
                <button type="submit" class="btn btn-danger">삭제</button>
            </form>
        </div>
    {% endif %}

{% endblock %}
