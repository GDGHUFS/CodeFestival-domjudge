{% extends "partials/modal.html.twig" %}

{% block title %}삭제: {{ type }} {{ primaryKey }} - "{{ description }}"{% endblock %}

{% block content %}

    {% if isError %}
        <div class="alert alert-danger">
            <strong>오류: {{ messages.0 }}</strong>
        </div>
    {% else %}
        <p>현재 {{ type }} {{ primaryKey }} "{{ description }}"을(를) 삭제하려고 합니다.</p>

        {% if messages is not empty %}
            <p>
                <strong>경고, 이 작업은 다음을 수행합니다:</strong>
            </p>
            <ul>
                {% for message in messages %}
                    <li>{{ message }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        <p>정말로 삭제하시겠습니까?</p>
    {% endif %}

{% endblock %}

{% block closeButtonText %}
    {% if isError %}확인{% else %}취소{% endif %}
{% endblock %}

{% block buttonText %}삭제{% endblock %}
