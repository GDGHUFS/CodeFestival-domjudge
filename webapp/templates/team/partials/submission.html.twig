{% if judging is empty or (not showTooLateResult and judging.submission.submittime >= current_team_contest.endtime) or (verificationRequired and not judging.verified) %}
    <div class="alert alert-danger">이 팀의 제출을 찾을 수 없거나 아직 채점되지 않았습니다.</div>
{% else %}
    <div class="container">
        {% if not judging.valid %}
            <div class="alert alert-warning">이 제출은 무시됩니다. 점수 계산에 사용되지
                않습니다.
            </div>
        {% endif %}

        <div class="d-flex flex-row">
            <div class="p-2">
                문제:
                <b>
                        <span class="probid">
                            {{ judging.submission.contestProblem.shortname }}</span> -
                    {{ judging.submission.contestProblem.problem.name }}
                </b>
            </div>
            <div class="p-2">
                제출 시각:
                <b>{{ judging.submission.submittime | printtime(null, current_team_contest) }}</b>
            </div>
            <div class="p-2">
                언어:
                <b>{{ judging.submission.language.name }}</b>
            </div>
            {% if not showCompile %}
                <div class="p-2">
                    컴파일 상태:
                    {% if judging.result == 'compiler-error' %}
                        <span class="badge text-bg-danger">실패</span>
                    {% else %}
                        <span class="badge text-bg-success">성공</span>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {% if judging.result != 'compiler-error' %}
            <div class="d-flex flex-row">
                <div class="p-2">
                    결과: {{ judging.result | printResult }}
                </div>
                {% if judging.result == 'correct' and judging.submission.contest.getRuntimeAsScoreTiebreaker() %}
                    <div class="p-2">
                        최대 실행 시간: <b>{{ "%0.3f s" | format(judging.getMaxRuntime()) }}</b>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if allowDownload %}
            <div class="d-flex flex-row">
                <div class="p-2">
                    <a title="제출 ZIP 다운로드" aria-label="download submission zip" class="btn btn-primary" href="{{ path('team_submission_download', {'submitId': judging.submission.submitid}) }}">
                        <i class="fa fa-file-archive"></i> 제출 ZIP 다운로드
                    </a>
                </div>
            </div>
        {% endif %}

        {% if showCompile %}
            <hr/>
            <h6 class="text-center">
                컴파일
                {% if judging.result == 'compiler-error' %}
                    <span class="badge text-bg-danger">실패</span>
                {% else %}
                    <span class="badge text-bg-success">성공</span>
                {% endif %}
                / 출력 내용
            </h6>
            {% if judging.outputCompile(true) is not empty %}
                <pre class="output_text pre-scrollable">{{ judging.outputCompile(true) }}</pre>
            {% else %}
                <p class="nodata">컴파일 오류나 경고가 없습니다.</p>
            {% endif %}
        {% endif %}

        {% if showSampleOutput and judging.result != 'compiler-error' %}
            <hr/>
            <h4 class="text-center">제공된 샘플 데이터로 실행 결과</h4>

            {% if runs is empty %}
                <p class="nodata">샘플 테스트가 없습니다.</p>
            {% else %}
                {% for run in runs %}
                    <h5 id="run-{{ run.0.rank }}" class="text-center mt-4">Run {{ run.0.rank }}</h5>

                    {% set judgingRun = run.0.judgingRuns.first %}
                    {% if judgingRun == null or judgingRun.runresult == null %}
                        <p class="nodata">아직 실행이 완료되지 않았습니다.</p>
                    {% else %}
                        <div class="row">
                            <div class="col-md-{{ size|default(4) }}">
                                <table class="table table-sm table-striped">
                                    <tr>
                                        <th>설명</th>
                                        <td>{{ run.0.description(true) }}</td>
                                    </tr>
                                    <tr>
                                        <th>실행 시간</th>
                                        <td>{{ judgingRun.runtime }} 초</td>
                                    </tr>
                                    <tr>
                                        <th>결과</th>
                                        <td>
                                            {{ judgingRun.runresult | printResult }}
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        {% if judging.submission.problem.combinedRunCompare %}
                            <h6 class="mt-3">심사자 / 제출 간 상호작용</h6>
                            {% if run.output_run is empty %}
                                <p class="nodata">상호작용 기록이 없습니다.</p>
                            {% else %}
                                {{ run.output_run | interactiveLog(true) }}
                            {% endif %}
                            {% if run.team_message is not empty %}
                                <h6 class="mt-3">심사자 메시지</h6>
                                <pre class="output_text">
{{  run.team_message }}</pre>
                            {%  endif %}
                        {% else %}
                            <h6 class="mt-3">프로그램 출력</h6>
                            {% if run.output_run is not empty %}
                                <pre class="output_text">
{{ run.output_run }}</pre>
                            {% else %}
                                <p class="nodata">프로그램 출력이 없습니다.</p>
                            {% endif %}

                            {% if run.team_message is not empty %}
                                <h6 class="mt-3">심사자 메시지</h6>
                                <pre class="output_text">
{{  run.team_message }}</pre>
                            {%  endif %}

                            <h6 class="mt-3">오류 출력 (info/debug/errors)</h6>
                            {% if run.output_error is not empty %}
                                <pre class="output_text">
{{ run.output_error }}</pre>
                            {% else %}
                                <p class="nodata">stderr 오류 출력이 없습니다.</p>
                            {% endif %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% endif %} {# not runs is empty #}
        {% endif %} {# showSampleOutput and judging.result != 'compiler-error' #}
    </div>
{% endif %} {# not (judging is empty or judging.submission.submittime >= current_team_contest.endtime or (verificationRequired and not judging.verified)) #}
